# Laravel package .gitattributes
# Enforce LF line endings for all text files
* text=auto eol=lf

# PHP & Laravel specific files
*.php     text eol=lf
*.blade.php text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.sass    text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.env     text eol=lf
*.gitignore text eol=lf

# Lock binary files (no EOL conversions)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.gz      binary
*.phar    binary
